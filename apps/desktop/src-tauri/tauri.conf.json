{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EchoFlow",
  "version": "0.1.0",
  "identifier": "com.echoflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay-pill",
        "title": "EchoFlow Overlay Pill",
        "url": "/?view=overlay",
        "width": 440,
        "height": 84,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
